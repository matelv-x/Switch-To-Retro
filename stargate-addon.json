{
  "maintenance_contract": 1,
  "id": "switch-to-retro",
  "name": "Switch To Retro",
  "repository": "matelv-x/Switch-To-Retro",
  "platforms": ["v4"],
  "detect": {"all": [{"path": "web/js/home_redirect.js"}]},
  "install": {"argv": ["./switch-to-retro.sh", "true", "retro/dial.html"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
  "uninstall": {"argv": ["./restore-switch-to-retro.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
  "restart_required": true
}
